# =============================================================================
# Copy to .env (`cp .env.example .env`). Development defaults only — never put
# real secrets here. APP_KEY and the JWT keys are generated by `make bootstrap`.
# =============================================================================

# --- Docker Compose ---------------------------------------------------------
# Unique per git worktree (`make wt` rewrites both) so stacks never collide.
COMPOSE_PROJECT_NAME=ecommerce-platform
# The only port published on the host (edge nginx). Worktrees use 8081..8084.
EDGE_PORT=8080
# Mailpit web UI (development only).
MAILPIT_UI_PORT=8025

# --- Laravel (backend/api) ---------------------------------------------------
APP_NAME="E-commerce Platform"
APP_ENV=local
# Must be false outside local: problem+json never exposes traces.
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_KEY=
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db-app
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=app-dev-password

# Separate database used only by the test suite (RefreshDatabase).
# Requirement 3 (ADR-0014): streaming read replica of db-app. The api reads
# from db-app-replica; a caller that wrote reads the primary for
# DB_READ_YOUR_WRITES_SECONDS. The replication role is created by db-app-roles.
DB_READ_HOST=db-app-replica
DB_READ_YOUR_WRITES_SECONDS=5
REPLICATION_USER=replicator
REPLICATION_PASSWORD=replication-dev-password

DB_TEST_HOST=db-app-test
DB_TEST_DATABASE=app_test
DB_TEST_USERNAME=app
DB_TEST_PASSWORD=app-test-password

# Requirement 3: the runtime cache store is always Redis (compose.yaml sets
# CACHE_STORE=redis for api/scheduler; the test suite uses the array store).
REDIS_PASSWORD=redis-dev-password
# Catalogue cache entries (categories, product pages, product details) live
# at most this many seconds; edits invalidate them immediately anyway.
CATALOG_CACHE_TTL=600
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@ecommerce.local
MAIL_FROM_NAME="${APP_NAME}"

# PHP-FPM workers. >= 16 so the race test is truly concurrent at the inventory.
PHP_FPM_MAX_CHILDREN=16

# JWT (ADR-0003). Keys live in backend/api/storage/keys (git-ignored, 0600).
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=ecommerce-api
JWT_ACCESS_TTL=900
JWT_LEEWAY=30
JWT_REFRESH_TTL_DAYS=14

# Inventory gRPC client (docs/03 section 2). Always through toxiproxy.
INVENTORY_GRPC_TARGET=toxiproxy:50051
INVENTORY_DEADLINE_GET_MS=500
INVENTORY_DEADLINE_RESERVE_MS=2000
INVENTORY_DEADLINE_RELEASE_MS=1000
INVENTORY_DEADLINE_ADJUST_MS=2000
INVENTORY_ORDER_BUDGET_MS=3000

# --- Inventory service (backend/inventory) -----------------------------------
INVENTORY_DB_HOST=db-inventory
INVENTORY_DB_PORT=5432
INVENTORY_DB_NAME=inventory
INVENTORY_DB_USERNAME=inventory
INVENTORY_DB_PASSWORD=inventory-dev-password
INVENTORY_GRPC_PORT=9090
INVENTORY_HIKARI_MAX_POOL=20
# Postgres timeouts per transaction; below the longest client deadline (2s).
INVENTORY_LOCK_TIMEOUT_MS=1500
INVENTORY_STATEMENT_TIMEOUT_MS=1800

# --- Tests ---------------------------------------------------------------------
# Playwright and k6 run inside containers that share edge's network namespace
# (`network_mode: service:edge`), so the app is reached as http://localhost —
# required because browsers only send the Secure refresh cookie over plain
# http to localhost. Toxiproxy's admin API is reached by service name.
EDGE_URL=http://localhost
TOXIPROXY_URL=http://toxiproxy:8474

# --- Dev/test accounts (never created when APP_ENV=production) -----------------
# D-04: test customers come from a seeder, so the register rate limit (5/hour
# per IP) stays real in every environment. Emails: customer{N}@example.test.
SEED_CUSTOMER_COUNT=60
SEED_CUSTOMER_PASSWORD=
# D-05: `make bootstrap` creates this admin; empty passwords are generated
# randomly into .env on first run.
DEV_ADMIN_EMAIL=admin@example.test
DEV_ADMIN_PASSWORD=
