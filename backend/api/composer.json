{
    "name": "ecommerce-platform/api",
    "type": "project",
    "description": "Main application: users, products, orders and notifications (REST v1). Inventory is a separate gRPC service.",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-grpc": "*",
        "ext-pdo_pgsql": "*",
        "ext-sodium": "*",
        "google/protobuf": "^5.36.2",
        "grpc/grpc": "^1.85.0",
        "intervention/image": "^3.11.10",
        "laravel/framework": "^13.39",
        "lcobucci/jwt": "^5.6.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.13.2",
        "laravel/pint": "^1.32.1",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.7.8",
        "pestphp/pest-plugin-laravel": "^4.1.0",
        "studio-design/openapi-contract-testing": "^2.9.0",
        "symfony/yaml": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/",
            "Ecommerce\\Inventory\\V1\\": "generated/grpc/Ecommerce/Inventory/V1/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "lint": "pint",
        "lint:check": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G --no-progress",
        "test": "pest"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.4.27"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
