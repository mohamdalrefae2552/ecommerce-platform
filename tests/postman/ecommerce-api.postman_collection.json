  "item": [
    {
      "name": "0 - Login (run first)",
      "item": [
        {
          "name": "Login as Customer 1 (saves customer_token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = pm.response.json().data.access_token;",
                  "pm.collectionVariables.set('customer_token', t);",
                  "pm.test('customer_token saved', () => pm.expect(t).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"email\": \"customer1@example.test\", \"password\": \"Password1234\" }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login as Customer 2 (saves customer2_token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = pm.response.json().data.access_token;",
                  "pm.collectionVariables.set('customer2_token', t);",
                  "pm.test('customer2_token saved', () => pm.expect(t).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"email\": \"customer2@example.test\", \"password\": \"Password1234\" }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login as Admin (saves admin_token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = pm.response.json().data.access_token;",
                  "pm.collectionVariables.set('admin_token', t);",
