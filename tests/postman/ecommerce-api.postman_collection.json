              "mode": "raw",
              "raw": "{ \"email\": \"admin@example.test\", \"password\": \"Password1234\" }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "1 - Health",
      "item": [
        {
          "name": "Health check -> 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "2 - Users (Auth)",
      "item": [
        {
          "name": "Register new customer -> 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"name\": \"New Customer\", \"email\": \"user{{$randomInt}}@example.test\", \"password\": \"Password1234\", \"password_confirmation\": \"Password1234\" }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Limited to 5 registrations per hour per IP."
          }
        },
        {
          "name": "Login -> 200 (returns JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = pm.response.json().data.access_token;",
                  "pm.collectionVariables.set('customer_token', t);",
                  "pm.test('customer_token saved', () => pm.expect(t).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"email\": \"customer1@example.test\", \"password\": \"Password1234\" }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login with wrong password -> 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"email\": \"customer9@example.test\", \"password\": \"wrong-password\" }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Send 6 times in a row to get 429 (rate limit)."
          }
        },
        {
          "name": "Login with empty body -> 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Who am I -> 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Who am I without token -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Refresh token (cookie) -> 200",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "fetch"
              },
              {
                "key": "Origin",
                "value": "http://localhost:8080"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh",
            "description": "Uses the refresh_token cookie set by the last Login request."
          }
        },
        {
          "name": "Logout -> 204",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              },
              {
                "key": "X-Requested-With",
                "value": "fetch"
              },
              {
                "key": "Origin",
                "value": "http://localhost:8080"
              }
            ],
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
