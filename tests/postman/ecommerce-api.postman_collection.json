                  "if (j.data) pm.collectionVariables.set('new_product_id', j.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Postman Test Watch",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Created from Postman",
                  "type": "text"
                },
                {
                  "key": "price_minor",
                  "value": "50000000",
                  "type": "text"
                },
                {
                  "key": "category_id",
                  "value": "{{category_id}}",
                  "type": "text"
                },
                {
                  "key": "initial_stock",
                  "value": "4",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": "backend/api/database/demo-catalog/watch.jpg"
                }
              ]
            },
            "url": "{{baseUrl}}/products"
          }
        },
        {
          "name": "Admin: Edit product -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with the new name and price', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.data.name).to.eql('Postman Test Watch (edited)');",
                  "  pm.expect(j.data.price.amount_minor).to.eql(45000000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"name\": \"Postman Test Watch (edited)\", \"price_minor\": 45000000 }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/products/{{new_product_id}}"
          }
        },
        {
          "name": "Product details after edit -> 200 (no stale cache)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the next read shows the edit immediately', () => {",
